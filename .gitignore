# Root gitignore for AM & KHK Vegetable Merchants

# Python / Virtual Environment
venv/
.venv/
ENV/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Databases (SQLite)
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite
*.db
*.sqlite

# Frontend (Node / React)
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Backend Environment
backend/.env
.env

# Logs and system files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
Thumbs.db
desktop.ini
.DS_Store

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Agent Scratchpads & Artifacts
.gemini/
.agents/
scratch/
walkthrough.md
task.md
implementation_plan.md
verify_*.py
backend/verify_*.py
